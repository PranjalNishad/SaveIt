# Required
BOT_TOKEN=your_telegram_bot_token


REDIS_URL=redis://127.0.0.1:6379

# Optional fallback if REDIS_URL is not set
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# sudo systemctl start redis - to start redis server
# redis-cli ping - Should print: PONG
# sudo systemctl enable redis - to enable redis server on startup
# docker compose up -d redis - to start redis server using docker

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
INFLIGHT_DEDUPE_TTL_SECONDS=360

# Media limits
MAX_FILE_SIZE_MB=50
MEDIA_CACHE_TTL_SECONDS=86400

# App paths/logging
TEMP_DIR=./temp
LOG_LEVEL=info
LOG_DIR=./logs

# ── YouTube / downloads (all optional) ────────────────────────────────────────
# yt-dlp player clients tried in order (no cookies needed). Change only if
# YouTube breaks a client. Default: tv_embedded,default,web_safari
# YTDLP_YT_CLIENTS=tv_embedded,default,web_safari

# Cookies are OPTIONAL — primary YouTube path needs none. Point at mounted files.
# YOUTUBE_COOKIES_FILE=/app/cookies/youtube_cookies.txt
# INSTAGRAM_COOKIES_FILE=/app/cookies/instagram_cookies.txt

# Cobalt fallback (only used if set). Public api.cobalt.tools now needs auth.
# COBALT_API_KEY=
# COBALT_INSTANCES=https://my-cobalt.example.com
