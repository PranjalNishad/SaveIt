# Required
BOT_TOKEN=your_telegram_bot_token


REDIS_URL=redis://127.0.0.1:6379

# Optional fallback if REDIS_URL is not set
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# sudo systemctl start redis - to start redis server
# redis-cli ping - Should print: PONG
# sudo systemctl enable redis - to enable redis server on startup
# docker compose up -d redis - to start redis server using docker

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
INFLIGHT_DEDUPE_TTL_SECONDS=360

# Media limits
# NOTE: the Telegram Bot API upload limit is 50MB for bots. Values above 50 are
# CLAMPED to 50 at startup (with a warning) so a bad value can't cause huge
# downloads that then fail to upload.
MAX_FILE_SIZE_MB=50
MEDIA_CACHE_TTL_SECONDS=86400
# Refuse to start a download when free disk is below this (MB). Default: 500
MIN_FREE_DISK_MB=500

# Worker / downloader
# Concurrent download jobs per worker. Keep this LOW — each job can spawn
# yt-dlp + ffmpeg and consume real CPU/RAM. Default: 4
WORKER_CONCURRENCY=4
# Hard timeout for a single yt-dlp run, in seconds. Default: 300
YTDLP_TIMEOUT_SECONDS=300
# yt-dlp -f selector. Default keeps best video+audio (post-download 50MB guard
# still applies). If most videos exceed the limit, try a size-bounded chain:
#   bv*[filesize_approx<=45M]+ba/b[filesize_approx<=45M]/bv*+ba/b
# YTDLP_FORMAT_SELECTOR=bv*+ba/b

# App paths/logging
TEMP_DIR=./temp
LOG_LEVEL=info
LOG_DIR=./logs

# Supervisor: how long to let the bot/worker drain in-flight downloads after
# SIGTERM before force-killing (ms). Docker stop_grace_period must exceed this.
# Default: 60000
SHUTDOWN_GRACE_MS=60000

# ── YouTube / downloads (all optional) ────────────────────────────────────────
# yt-dlp player clients tried in order (no cookies needed). Change only if
# YouTube breaks a client. Default: tv_embedded,default,web_safari
# YTDLP_YT_CLIENTS=tv_embedded,default,web_safari

# Cookies are OPTIONAL — primary YouTube path needs none. Point at mounted files.
# If unset, ./cookies/<platform>_cookies.txt is used when it exists (local dev),
# otherwise /app/cookies/<platform>_cookies.txt (Docker volume).
# YOUTUBE_COOKIES_FILE=/app/cookies/youtube_cookies.txt
# INSTAGRAM_COOKIES_FILE=/app/cookies/instagram_cookies.txt

# Cobalt fallback (only used if set). Public api.cobalt.tools now needs auth.
# COBALT_API_KEY=
# COBALT_INSTANCES=https://my-cobalt.example.com
